# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# The real ".env" file is ignored by git, so your secrets stay private.
# ------------------------------------------------------------------

# Port used when you run the server on your computer
PORT=5000

# MongoDB connection (get it from MongoDB Atlas -> Connect -> Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB=gearhive

# Secret used to sign / verify JWT tokens.
# IMPORTANT: this must be EXACTLY the same value as JWT_SECRET in the client project.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Website address(es) allowed to call this API (CORS). Separate several with commas.
CLIENT_URL=http://localhost:3000

# Stripe (https://dashboard.stripe.com/test/apikeys) - use TEST keys
STRIPE_SECRET_KEY=sk_test_replace_me
# Optional: only needed if you set up a Stripe webhook (see README)
STRIPE_WEBHOOK_SECRET=

# Cron job that marks finished rentals as "completed"
ENABLE_CRON=true
# Default = every day at 00:05 (server time)
CRON_SCHEDULE=5 0 * * *

# Optional e-mail notifications (leave empty to skip sending e-mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="GearHive <no-reply@gearhive.example>"
